
# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=retail-refund

# ==========================================
# FastAPI / SQLAlchemy
# ==========================================
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@127.0.0.1:5432/retail-refund

# Psycopg
DATABASE_PSYCOPG_URL=postgresql://your_postgres_user:your_postgres_password@127.0.0.1:5432/retail-refund

POSTGRES_ECHO_SQL=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=0

# ==========================================
# MinIO
# ==========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=product-images
MINIO_SECURE=false

MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password

# ==========================================
# Keycloak
# ==========================================
KEYCLOAK_ADMIN=your_keycloak_admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password

KEYCLOAK_ISSUER=http://localhost:8081/realms/returnguard
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/returnguard/protocol/openid-connect/certs
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_AUDIENCE=retail-refund-api
KEYCLOAK_CLIENT_ID=returnguard-backend
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# Keycloak realm configuration
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=returnguard

# ==========================================
# Redis
# ==========================================
# Host machine connection (Docker port mapping: 6380:6379)
REDIS_URL=redis://localhost:6380/0

# ==========================================
# AI API Keys
# ==========================================
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key

OPENAI_EMBEDDING_MODEL=text-embedding-3-small

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

FALLBACK_LLM_PROVIDER=openai
FALLBACK_LLM_MODEL=gpt-4o-mini

IMAGE_MODEL=gpt-4o

# ==========================================
# Vector Database (Qdrant)
# ==========================================
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=returnguard_policies

# ==========================================
# Langfuse (LLM Observability)
# ==========================================
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_BASE_URL=your_langfuse_base_url

# ==========================================
# Human Review
# ==========================================
HUMAN_REVIEW_KILL_SWITCH=true
